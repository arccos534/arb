# This version reads public data only. No private keys or exchange credentials.
APP_MODE=research
WEB_PORT=4317
OBSERVER_AUTOSTART=true
AUDIT_MAX_MB=2048
DATA_DIR=./data
LOG_LEVEL=info
# Empty = bounded JSONL journal. Set for PostgreSQL persistence.
DATABASE_URL=
STORAGE_POSTGRES=false
# 0 = all future expiries; include markets until their trading window ends.
HORIZON_HOURS=0
MIN_HOURS_TO_END=0
DISCOVERY_INTERVAL_SECONDS=300
REST_REFRESH_SECONDS=30
# 0 = paginate to completion and watch every matching pair.
MAX_PAGES=0
MAX_WATCH_PAIRS=0
REQUEST_TIMEOUT_MS=10000
# Per-origin spacing; urgent execution refreshes precede catalogue requests.
# A client setting, not an exchange quota; 429/Retry-After applies to all callers.
MIN_HTTP_INTERVAL_MS=100
MAX_BOOK_AGE_MS=2000
MAX_BOOK_SKEW_MS=750
TARGET_NET_SHARES=10
MAX_POSITION_COST_USD=10
MIN_NET_ROI=0.03
# Explicit research assumptions, not measured expenses:
REBALANCE_COST_PER_PAIR_USD=0.10
EXECUTION_BUFFER_USD=0.05
# Limitless fees use the published price-dependent table (estimated per level).
# Per local UTC date. Stops instead of filling a small VPS disk.
MAX_JOURNAL_MB=128
MAX_TOTAL_JOURNAL_MB=1024
SNAPSHOT_INTERVAL_SECONDS=30
# Conservative REST confirmation remains necessary: REST does not guarantee freshness.
USE_WEBSOCKETS=true
# Docker Compose only: set a unique password before starting the database.
POSTGRES_PASSWORD=
