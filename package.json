{
  "name": "prediction-arbitrage-research",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "scan": "tsx src/cli.ts scan",
    "observe": "tsx src/cli.ts observe",
    "benchmark": "tsx src/cli.ts benchmark",
    "benchmark:performance": "node scripts/benchmark-performance.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "diagnose:execution": "tsx src/diagnostics/collector.ts",
    "report": "tsx src/cli.ts report",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "reset:local": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/reset-local.ps1",
    "app": "tsx src/server.ts",
    "test:ui": "node tests/browser.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "check": "npm run typecheck && node --check web/app.js && npm test && npm run build"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "pino": "^10.0.0",
    "socket.io-client": "^4.8.1",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "playwright": "^1.64.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
